# Base URL of the Laravel API (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Laravel app origin — used by Sanctum for the CSRF cookie endpoint
VITE_API_ORIGIN=http://127.0.0.1:8000

# When true, the app falls back to bundled dummy data if the API is unreachable.
# Set to "false" once your Laravel backend is wired up.
VITE_USE_FALLBACK_DATA=true
